# Supabase project — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your site's real public URL (no trailing slash). Used for the sitemap,
# robots.txt, canonical links, and Open Graph tags so Google indexes the
# correct address. Use http://localhost:3000 while developing locally —
# update this to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Settings > API > service_role. NEVER expose to the client / commit this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by `npm run db:types`
SUPABASE_PROJECT_ID=your-project-ref

# AI Store Assistant — get a FREE key at https://aistudio.google.com/apikey
# (sign in with a Google account, no credit card / billing setup needed for
# the free tier). Without this, the assistant still runs (subscriptions,
# uploads, retrieval all work) but replies with a clear "temporarily
# unavailable" message instead of a generated answer.
GEMINI_API_KEY=your-gemini-api-key
# Optional — override the model (defaults to gemini-3.6-flash if unset)
GEMINI_MODEL=gemini-3.6-flash
